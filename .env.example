# Copy to .env and edit. Used by docker-compose.yml.

# Address players' game clients use to reach this machine (public IP or DNS name).
# If this stays 127.0.0.1 only players on the host itself can join matches.
STORM_PUBLIC_HOST=203.0.113.10

# Password for the "admin" account used to sign in to /admin.
STORM_ADMIN_PASSWORD=change-me-please

# HTTP port for the API and admin panel.
STORM_HTTP_PORT=8080

# UDP ports for game servers: one port per concurrent match. Keep the range small when
# publishing ports through Docker (each port adds overhead); 10 ports = 10 matches.
STORM_PORTS=7777-7786

# Shared secret between the backend and game servers. Only needed if you also run game
# servers on other machines; otherwise one is generated and stored in the database.
# STORM_SERVER_SECRET=

# Set to 1 to never start game servers in this container (only accept external ones).
# STORM_NO_SPAWN=1
